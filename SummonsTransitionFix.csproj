<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SummonsTransitionFix</AssemblyName>
    <RootNamespace>SummonsTransitionFix</RootNamespace>
    <Version>1.0.7</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ManagedPath>$(GamePath)\Wrath_Data\Managed</ManagedPath>
    <StagingPath>$(MSBuildProjectDirectory)\bin\Staging</StagingPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedPath)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(ManagedPath)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedPath)\UnityModManager\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Info.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Localization\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckGamePath" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GamePath)' == ''" Text="GamePath is not set. Set the GamePath environment variable to the game folder, or pass -p:GamePath=&quot;...&quot; to dotnet build." />
    <Error Condition="!Exists('$(ManagedPath)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found in '$(ManagedPath)'. GamePath must point to the folder that contains Wrath_Data." />
  </Target>

  <Target Name="CreateZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <LocalizationFiles Include="$(MSBuildProjectDirectory)\Localization\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(StagingPath)" />
    <Copy SourceFiles="$(TargetDir)SummonsTransitionFix.dll;$(MSBuildProjectDirectory)\Info.json" DestinationFolder="$(StagingPath)\SummonsTransitionFix" />
    <Copy SourceFiles="@(LocalizationFiles)" DestinationFolder="$(StagingPath)\SummonsTransitionFix\Localization\%(RecursiveDir)" />
    <ZipDirectory SourceDirectory="$(StagingPath)" DestinationFile="$(MSBuildProjectDirectory)\bin\SummonsTransitionFix-$(Version).zip" Overwrite="true" />
    <RemoveDir Directories="$(StagingPath)" />
  </Target>

</Project>
